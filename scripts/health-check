#!/usr/bin/env bash
set -euo pipefail

subnet="192.168.100.0/24"
port="4242"

valid_cidr() {
  local cidr="$1"
  [[ "$cidr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] || return 1
  local ip="${cidr%/*}"
  IFS='.' read -r a b c d <<<"$ip"
  for octet in "$a" "$b" "$c" "$d"; do
    ((octet >= 0 && octet <= 255)) || return 1
  done
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && ((1 <= $1 && $1 <= 65535))
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --subnet)
      subnet="$2"
      shift 2
      ;;
    --port)
      port="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if ! valid_cidr "$subnet"; then
  echo "state=red"
  echo "message=Invalid subnet setting"
  exit 0
fi

if ! valid_port "$port"; then
  echo "state=red"
  echo "message=Invalid port setting"
  exit 0
fi

package_installed=0
config_exists=0
firewall="unknown"
service_installed=0
service_enabled=0
service_active=0
message=""

if command -v lan-mouse >/dev/null 2>&1; then
  package_installed=1
else
  message="lan-mouse package is not installed"
fi

config_path="${XDG_CONFIG_HOME:-$HOME/.config}/lan-mouse/config.toml"
if [[ -f "$config_path" ]]; then
  config_exists=1
fi

if command -v ufw >/dev/null 2>&1; then
  if status="$(sudo -n ufw status 2>/dev/null)"; then
    status="$(tr -s ' ' <<<"$status")"
    if grep -Fq "$port/udp" <<<"$status" && grep -Fq "$subnet" <<<"$status"; then
      firewall="ok"
    elif grep -Fq "$port/udp" <<<"$status"; then
      firewall="port-present"
    else
      firewall="missing"
    fi
  else
    firewall="elevation-required"
  fi
else
  firewall="unavailable"
fi

if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/lan-mouse.service" ]]; then
  service_installed=1
fi

if systemctl --user is-enabled lan-mouse.service >/dev/null 2>&1; then
  service_enabled=1
fi

if systemctl --user is-active lan-mouse.service >/dev/null 2>&1; then
  service_active=1
fi

state="amber"
if (( package_installed == 0 )); then
  state="red"
elif [[ "$firewall" == "elevation-required" ]]; then
  state="gray"
elif (( package_installed == 1 && config_exists == 1 && service_active == 1 )) && [[ "$firewall" == "ok" ]]; then
  state="green"
fi

if [[ -z "$message" ]]; then
  case "$state" in
    green) message="Lan Mouse is fully configured" ;;
    gray) message="Firewall inspection requires sudo authentication" ;;
    red) message="Lan Mouse is unavailable" ;;
    *) message="Setup incomplete or daemon stopped" ;;
  esac
fi

echo "state=$state"
echo "package_installed=$package_installed"
echo "config_exists=$config_exists"
echo "firewall=$firewall"
echo "service_installed=$service_installed"
echo "service_enabled=$service_enabled"
echo "service_active=$service_active"
echo "message=$message"
