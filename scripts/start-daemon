#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/omarchy-lan-mouse"
pid_file="$runtime_dir/lan-mouse.pid"
mkdir -p "$runtime_dir"

if [ -f "$pid_file" ] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
  exit 0
fi

rm -f "$pid_file"
lan-mouse daemon &
printf '%s\n' "$!" > "$pid_file"
